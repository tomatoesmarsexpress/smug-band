---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
// 1. Die Image-Komponente importieren
import { Image } from 'astro:assets';

// 2. Alle Bilder explizit importieren
import logoImg from '../assets/images/smuglogo.webp';
import fynnImg from '../assets/images/fynnimage.png';
import xbarImg from '../assets/images/xbarbild.png';
import jakeImg from '../assets/images/jakesax.png';
import jakeImBild from '../assets/images/jakeimbild.jpg';
import deluxeCover from '../assets/images/delux-version-cover.jpg';
import stageplanPdf from '../assets/pdf/Stageplan_SMUG.pdf';

const epkPhotos = [
  { src: jakeImBild, alt: "EPK Foto 1" },
  { src: fynnImg, alt: "EPK Foto 2" },
  { src: xbarImg, alt: "EPK Foto 3" },
  { src: jakeImg, alt: "EPK Foto 4" },
];

const onStageVideos = [
  {
    src: "https://www.youtube-nocookie.com/embed/mvfBE63oKJ0",
    title: "(I dont wanna pay my) Taxes — Live",
  },
];

const LATEST_RELEASE = {
  title: "Deluxe Version",
  type: "EP",
  href: "https://smugmusik.bandcamp.com/album/deluxe-version",
  cover: deluxeCover,
};
---

<Layout>
  <main class="mx-auto w-full max-w-6xl px-4 pb-16 pt-24 sm:px-8 page-fade-in">

    <header class="mb-10">
      <div class="flex justify-center mb-6">
        <a href="/" aria-label="Zur Startseite">
          <Image
            src={logoImg}
            alt="Band Logo"
            width={900}
            height={320}
            class="h-auto w-auto max-w-[16rem] object-contain sm:max-w-[18rem]"
          />
        </a>
      </div>

      <div class="inline-flex items-center gap-3 rough-box px-4 py-3">
        <span class="text-3xl font-black uppercase tracking-[0.08em]">EPK</span>
        <span class="text-sm font-semibold sm:text-base">Electronic Press Kit</span>
      </div>
    </header>

    <section class="space-y-8">

      <div class="rounded-lg border-2 border-black/80 bg-white/60 p-5 shadow-sm">
        <h2 class="text-2xl font-black uppercase tracking-[0.06em] sm:text-3xl">about</h2>
        <p class="mt-3 text-sm leading-relaxed sm:text-base">
          Die 2023 gegründete Alt-Punk Band SMUG (fka CAC) macht in Münchens Underground schon seit Jahren große Wellen. Die schwer fassbare Gruppe hat mit ihren über 20 Shows rund um München einen Ruf aufgebaut von chaotischen Persönlichkeiten, experimentellen Sound, und einen radikalen Ansatz zu Musik und Performance.
          <br><br>
          Mit ihrer Single „BWLER“ erreichten sie auf Instagram über eine Million Aufrufe und schafften es, ihre Fangemeinschaft weit über München hinaus zu verbreiten. Mit ihrer langersehnten EP „Deluxe Version“ verfestigt SMUG ihren einzigartigen Klang und schafft es beim nächsten Release ganz sicher auch in die Charts.
        </p>
      </div>

      <div class="rounded-lg border-2 border-black/80 bg-white/60 p-5">
        <h2 class="text-2xl font-black uppercase tracking-[0.06em] sm:text-3xl">On Stage Videos</h2>
        <div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-2">
          {onStageVideos.map((v) => (
            <div class="w-full md:col-span-2 md:max-w-3xl md:mx-auto">
              <div class="relative w-full pt-[56.25%]">
                <iframe
                  class="absolute inset-0 h-full w-full rounded-lg"
                  src={v.src}
                  title={v.title}
                  loading="lazy"
                  allowfullscreen
                ></iframe>
              </div>
              <p class="mt-2 text-center text-sm font-semibold">{v.title}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-lg border-2 border-black/80 bg-white/60 p-5">
        <h2 class="text-2xl font-black uppercase tracking-[0.06em] sm:text-3xl">Pics</h2> 
        <div class="relative mt-4">

          <button type="button" id="scrollLeft" class="absolute left-0 top-1/2 z-10 -translate-y-1/2 rounded-full border-2 border-black/80 bg-white/80 px-3 py-2 text-black shadow-sm hover:bg-white">←</button>
          <button type="button" id="scrollRight" class="absolute right-0 top-1/2 z-10 -translate-y-1/2 rounded-full border-2 border-black/80 bg-white/80 px-3 py-2 text-black shadow-sm hover:bg-white">→</button>

          <div id="photoScroller" class="overflow-x-auto pb-2 pt-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            <div class="flex gap-4 pr-10">
              {epkPhotos.map((photo) => (
                <figure class="w-[70vw] max-w-[340px] flex-none rounded-lg bg-black/5 p-2 shadow-sm">
                  <div class="relative aspect-[4/3] w-full overflow-hidden rounded-md">
                    <Image
                      src={photo.src}
                      alt={photo.alt}
                      class="h-full w-full object-contain"
                    />
                  </div>
                </figure>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="rounded-lg border-2 border-black/80 bg-white/60 p-5">
        <h2 class="text-2xl font-black uppercase tracking-[0.06em] sm:text-3xl">Neuste Release</h2>
        <a
          href={LATEST_RELEASE.href}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 flex max-w-md items-center gap-4 rounded-lg border-2 border-black/80 bg-white/70 p-3 transition-transform duration-200 hover:-translate-y-0.5"
        >
          <Image
            src={LATEST_RELEASE.cover}
            alt={`${LATEST_RELEASE.title} Cover`}
            class="h-28 w-28 shrink-0 rounded-md object-cover sm:h-32 sm:w-32"
          />
          <div>
            <p class="text-lg font-black uppercase tracking-[0.06em]">{LATEST_RELEASE.title}</p>
            <p class="mt-1 text-sm font-semibold uppercase tracking-[0.12em] text-black/55">{LATEST_RELEASE.type}</p>
            <p class="mt-3 text-sm font-semibold underline decoration-2 underline-offset-4">
              Auf Bandcamp anhören →
            </p>
          </div>
        </a>
      </div>

      <div class="rounded-lg border-2 border-black/80 bg-white/60 p-5">
        <h2 class="text-2xl font-black uppercase tracking-[0.06em] sm:text-3xl">Spotify</h2>
        <div class="mt-4">
          <iframe
            class="w-full rounded-xl"
            style="border-radius:12px"
            src="https://open.spotify.com/embed/track/1KfxliYQULuMnVV2WCnuzn?utm_source=generator"
            height="352"
            frameborder="0"
            allowfullscreen
            allow="clipboard-write; fullscreen; picture-in-picture"
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div class="rounded-lg border-2 border-black/80 bg-white/60 p-5">
        <h2 class="text-2xl font-black uppercase tracking-[0.06em] sm:text-3xl">Stageplan</h2>
        <p class="mt-3 text-sm leading-relaxed sm:text-base">
          Für Booker*innen: unser aktueller Stageplan als PDF zum Download.
        </p>
        <a
          href={stageplanPdf}
          download="Stageplan_SMUG.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 rounded-lg border-2 border-black/80 bg-black px-6 py-2 font-semibold lowercase text-white transition-colors hover:bg-black/90"
        >
          Stageplan herunterladen 
        </a>
      </div>

      <div class="rounded-lg border-2 border-black/80 bg-white/60 p-5">
        <h2 class="text-2xl font-black uppercase tracking-[0.06em] sm:text-3xl">Kontakt</h2>
        <p class="mt-3 text-sm leading-relaxed sm:text-base">
          Schreib uns gerne eine E-Mail:
        </p>
        <a
          href="mailto:smug.kontakt@gmail.com"
          class="mt-4 inline-block rounded-lg border-2 border-black/80 bg-black px-6 py-2 font-semibold lowercase text-white transition-colors hover:bg-black/90"
        >
          smug.kontakt@gmail.com
        </a>
      </div>

    </section>
  </main>
</Layout>

<script>
  // Scroller Script bleibt gleich...
  const scroller = document.getElementById('photoScroller')!;
  document.getElementById('scrollLeft')!.addEventListener('click', () => {
    scroller.scrollBy({ left: -Math.max(240, scroller.clientWidth * 0.75), behavior: 'smooth' });
  });
  document.getElementById('scrollRight')!.addEventListener('click', () => {
    scroller.scrollBy({ left: Math.max(240, scroller.clientWidth * 0.75), behavior: 'smooth' });
  });
</script>